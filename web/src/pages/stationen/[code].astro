---
import Page from "../../components/Page.astro";
import Trace from "../../components/Trace.astro";
import DailyChart from "../../components/DailyChart.astro";
import WindRose from "../../components/WindRose.astro";
import { href, num, type Hour } from "../../lib/atlas";
import { archive, histories, exposureName, lastValue, type StationHistory } from "../../lib/archive";

export function getStaticPaths() {
  return histories.map((h) => ({ params: { code: h.code }, props: { h } }));
}

const { h } = Astro.props as { h: StationHistory };
const { hourly, daily } = h;
// Trace only needs the time of each point.
const hours = hourly.times.map((utc) => ({ utc }) as Hour);
const at = (i: number) => new Date(hourly.times[i].replace("Z", ":00Z"));
const tz = "Europe/Rome";
const clock = (i: number) => {
  const day = new Intl.DateTimeFormat("de-DE", { weekday: "long", day: "numeric", month: "long", timeZone: tz }).format(at(i));
  const hour = new Intl.DateTimeFormat("de-DE", { hour: "numeric", hourCycle: "h23", timeZone: tz })
    .formatToParts(at(i)).find((p) => p.type === "hour")!.value;
  return `${day} um ${Number(hour)}`;
};

const now = {
  t: lastValue(hourly.LT), wind: lastValue(hourly.WG), dir: lastValue(hourly.WR), gust: lastValue(hourly["WG.BOE"]),
  rh: lastValue(hourly.LF), p: lastValue(hourly["LD.RED"]), hs: lastValue(hourly.HS),
};
const sum = (s?: (number | null)[], n = 24) => s?.slice(-n).reduce<number>((a, v) => a + (v ?? 0), 0);
const DIRS = ["Nord", "Nordost", "Ost", "Südost", "Süd", "Südwest", "West", "Nordwest"];
const charts: { key: string; title: string; unit: string; kind?: "bars"; digits?: number }[] = [
  { key: "LT", title: "Lufttemperatur", unit: "°C" },
  { key: "N", title: "Niederschlag pro Stunde", unit: "mm", kind: "bars" },
  { key: "WG", title: "Wind, Stundenmittel", unit: "m/s" },
  { key: "WG.BOE", title: "Stärkste Böe der Stunde", unit: "m/s" },
  { key: "LF", title: "Relative Luftfeuchte", unit: "%", digits: 0 },
  { key: "LD.RED", title: "Luftdruck, auf Meereshöhe reduziert", unit: "hPa" },
  { key: "HS", title: "Schneehöhe", unit: "cm", digits: 0 },
  { key: "SD", title: "Sonnenschein pro Stunde", unit: "min", kind: "bars", digits: 0 },
];
const shown = charts.filter((c) => hourly[c.key]?.some((v) => v != null) && !(c.key === "HS" && !hourly.HS?.some((v) => (v ?? 0) >= 1)));
---
<Page title={h.name} description={`Messwerte der Station ${h.name} (${h.alt} m) des Landeswetterdienstes Südtirol: letzte 7 Tage stündlich, letzte 30 Tage täglich.`}
      crumbs={[["/stationen/", "Stationen"]]}>
  <section class="measure intro">
    <h1 class="page-title">{h.name}</h1>
    <p class="station-meta">{h.name_it !== h.name && <>{h.name_it} · </>}{h.alt.toLocaleString("de-DE")} m · {exposureName[h.exposure]} · {num(h.lat, 3)}° N, {num(h.lon, 3)}° O</p>
    {now.t && <p class="lede">
      {clock(now.t.i)} Uhr: {num(now.t.value)} Grad{now.rh && <>, {num(now.rh.value, 0)} Prozent Luftfeuchte</>}.
      {now.wind && now.dir && <> Wind mit {num(now.wind.value)} Metern pro Sekunde aus {DIRS[Math.round(now.dir.value / 45) % 8]}{now.gust && <>, Böen bis {num(now.gust.value)}</>}.</>}
      {hourly.N && <> In den letzten 24 Stunden {num(sum(hourly.N))} Millimeter Niederschlag.</>}
      {now.hs && now.hs.value >= 1 && <> {num(now.hs.value, 0)} Zentimeter Schnee.</>}
    </p>}
    <p><a href={href("/?v=temperature#karte")}>Auf der Karte ansehen</a></p>
  </section>

  <section class="station-charts">
    <h2>Letzte 7 Tage</h2>
    {shown.map((c) => (
      <div class="station-chart">
        <h3>{c.title}</h3>
        <Trace hours={hours} values={hourly[c.key]} unit={c.unit} label={c.title} kind={c.kind} digits={c.digits ?? 1} />
      </div>
    ))}
    {hourly.WG && hourly.WR && archive.legend.wind && (
      <WindRose speed={hourly.WG} direction={hourly.WR} legend={archive.legend.wind} label="Windrichtung und -stärke der letzten 7 Tage" />
    )}
  </section>

  {daily.dates.length > 1 && (
    <section class="station-charts">
      <h2>Letzte {daily.dates.length} Tage</h2>
      <p class="note">Balken oben: Tiefst- bis Höchsttemperatur des Tages; Balken unten: Niederschlag.</p>
      <DailyChart dates={daily.dates} tmin={daily.tmin} tmax={daily.tmax} nsum={daily.n_sum} label="Tageswerte" />
    </section>
  )}
</Page>
