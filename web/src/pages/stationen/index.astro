---
import Page from "../../components/Page.astro";
import { href, num } from "../../lib/atlas";
import { archive, histories, stationList, exposureName, lastValue } from "../../lib/archive";

const byCode = Object.fromEntries(histories.map((h) => [h.code, h]));
const rows = stationList
  .filter((s) => byCode[s.code])
  .map((s) => {
    const h = byCode[s.code].hourly;
    return { ...s, t: lastValue(h.LT)?.value, wind: lastValue(h.WG)?.value, n24: h.N?.slice(-24).reduce<number>((a, v) => a + (v ?? 0), 0) };
  })
  .sort((a, b) => a.name.localeCompare(b.name, "de"));
// The station map uses the bare relief of the live maps.
const W = 1690, H = 1090;
const [xmin, xmax, ymin, ymax] = archive.extent;
const px = (x: number) => ((x - xmin) / (xmax - xmin)) * W;
const py = (y: number) => ((ymax - y) / (ymax - ymin)) * H;
---
<Page title="Stationen" description="Die Wetterstationen des Landeswetterdienstes Südtirol mit ihren Messwerten der letzten Tage." crumbs={[["/stationen/", "Stationen"]]}>
  <section class="measure intro">
    <h1 class="page-title">Stationen</h1>
    {rows.length
      ? <p class="lede">{rows.length} automatische Wetterstationen des Landeswetterdienstes, von {num(Math.min(...rows.map((r) => r.alt)), 0)} bis {num(Math.max(...rows.map((r) => r.alt)), 0)} Metern. Jede Station hat eine Seite mit ihren Messwerten der letzten Tage.</p>
      : <p class="lede">Die Stationsdaten stehen noch nicht bereit.</p>}
  </section>
  <section class="station-map">
    <div class="viewer-stage">
      <img class="shown" src={href("/maps/now/base.webp")} width="1690" height="1090" alt="Relief Südtirols mit den Wetterstationen" />
      <svg class="viewer-layer" viewBox={`0 0 ${W} ${H}`}>
        {rows.map((s) => (
          <a href={href(`/stationen/${s.code}/`)} aria-label={s.name}>
            <circle class={`station-dot ${s.exposure}`} cx={px(s.x)} cy={py(s.y)} r="9"><title>{s.name}, {s.alt} m</title></circle>
          </a>
        ))}
      </svg>
    </div>
  </section>
  <section>
    <table class="station-table">
      <thead><tr><th>Station</th><th>Höhe</th><th>Lage</th><th>Temperatur</th><th>Wind</th><th>Niederschlag 24 h</th></tr></thead>
      <tbody>
        {rows.map((s) => (
          <tr>
            <td><a href={href(`/stationen/${s.code}/`)}>{s.name}</a></td>
            <td class="num">{s.alt.toLocaleString("de-DE")} m</td>
            <td>{exposureName[s.exposure]}</td>
            <td class="num">{s.t != null ? `${num(s.t)} °C` : "–"}</td>
            <td class="num">{s.wind != null ? `${num(s.wind)} m/s` : "–"}</td>
            <td class="num">{s.n24 != null && byCode[s.code].hourly.N ? `${num(s.n24)} mm` : "–"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Page>
