---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource/ibm-plex-sans-condensed/400.css";
import "@fontsource/ibm-plex-sans-condensed/500.css";
import "../../styles/atlas.css";

import { href } from "../../lib/atlas";

// One event.json per archived event in data/events/ at the repository root.
type Event = { slug: string; title: string; start: string; hours: number; summary: string };
const events = Object.values(
  import.meta.glob<{ default: Event }>("../../../../data/events/*/event.json", { eager: true }),
).map((m) => m.default).sort((a, b) => b.start.localeCompare(a.start));

const when = (e: Event) =>
  new Date(`${e.start}:00`).toLocaleDateString("de-DE", { day: "numeric", month: "long", year: "numeric" });
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ereignisse · Wetter in Südtirol</title>
  <meta name="description" content="Archivierte Wetterlagen in Südtirol, Stunde für Stunde aus den Messstationen des Landeswetterdienstes." />
  <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
</head>
<body>
  <nav class="crumbs"><a href={href("/")}>Wetter jetzt</a></nav>
  <main>
    <section class="measure intro">
      <h1 class="page-title">Ereignisse</h1>
      <p class="lede">Wetterlagen, deren Karten und Messwerte dauerhaft erhalten bleiben.</p>
      <ol class="event-list">
        {events.map((e) => (
          <li>
            <a href={href(`/ereignisse/${e.slug}/`)}>{e.title}</a>
            <span class="when">ab {when(e)}, {e.hours} Stunden</span>
            <p>{e.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  </main>
</body>
</html>
