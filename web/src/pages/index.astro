---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/ibm-plex-sans-condensed/400.css";
import "@fontsource/ibm-plex-sans-condensed/500.css";
import "../styles/atlas.css";

import Trace from "../components/Trace.astro";
import Legend from "../components/Legend.astro";
import HourGrid from "../components/HourGrid.astro";
import Method from "../components/Method.astro";
import MapViewer from "../components/MapViewer.astro";
import { atlas, timeLabel, dayLabel, hourOf, num, mapUrl, href } from "../lib/atlas";
import raw from "../data/now.json";

const now = atlas(raw, "now");
const { hours, legend, stations, total } = now;
const first = hours[0];
const last = hours.at(-1)!;
const day = hours.slice(-24);
const dayAgo = hours.at(-25);
const threeAgo = hours.at(-4);

const tChange = dayAgo ? last.t_mean - dayAgo.t_mean : null;
const rain24 = day.reduce((s, h) => s + h.n_area, 0);
const gust = day.reduce((best, h) => ((h.gust_max ?? 0) > (best.gust_max ?? 0) ? h : best), day[0]);
const pTrend = last.p_mean != null && threeAgo?.p_mean != null ? last.p_mean - threeAgo.p_mean : null;
const pWord = pTrend == null ? null : pTrend > 0.6 ? "steigt" : pTrend < -0.6 ? "fällt" : "bleibt fast gleich";
const foehn = [...new Set(hours.slice(-6).flatMap((h) => h.foehn ?? []))];
const sentences = [
  `Um ${hourOf(last)} Uhr liegt die Temperatur im Flächenmittel bei ${num(last.t_mean)} Grad, ` +
    (tChange != null && Math.abs(tChange) >= 0.5
      ? `${num(Math.abs(tChange))} Grad ${tChange < 0 ? "kälter" : "wärmer"} als vor 24 Stunden.`
      : "etwa so warm wie vor 24 Stunden."),
  `Sie reicht von ${num(last.t_min)} Grad auf den Gipfeln bis ${num(last.t_max)} Grad in den Tälern` +
    (last.freezing_level ? `, die Nullgradgrenze liegt bei etwa ${last.freezing_level.toLocaleString("de-DE")} Metern.` : "."),
  rain24 >= 0.1
    ? `In den letzten 24 Stunden fielen im Flächenmittel ${num(rain24)} Millimeter Niederschlag.`
    : "Die letzten 24 Stunden blieben trocken.",
  gust.gust_max != null && `Die stärkste Böe maß ${gust.gust_station} mit ${num(gust.gust_max)} Metern pro Sekunde.`,
  pWord && `Der Luftdruck ${pWord}.`,
  foehn.length > 0 && `Föhnverdacht in den letzten sechs Stunden: ${foehn.join(", ")}.`,
];
const lede = sentences.filter(Boolean).join(" ");
const range = `${dayLabel(first).replace(/^\w+, /, "")} bis ${dayLabel(last).replace(/^\w+, /, "")}`;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Wetter in Südtirol, Stunde für Stunde</title>
  <meta name="description" content={`Temperatur, Niederschlag und Wind in Südtirol in den letzten ${hours.length} Stunden, aus den Messstationen des Landeswetterdienstes. Stand ${timeLabel(last)}.`} />
  <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
</head>
<body>
  <p class="stale" id="stale" data-newest={now.newest} hidden>
    Die Karten sind älter als zwei Stunden; der Abruf neuer Messwerte hängt gerade.
  </p>
  <script is:inline>
    // The page is static; warn when the last successful build is getting old.
    (() => {
      const el = document.getElementById("stale");
      const newest = Date.parse(el.dataset.newest.replace("Z", ":00Z"));
      if (Date.now() - newest > 2 * 3600e3) el.hidden = false;
    })();
  </script>

  <header class="plate">
    <div class="plate-map">
      <img src={mapUrl(now, "temperature", last.stamp)} width="1690" height="1090"
           alt={`Lufttemperatur in Südtirol, ${timeLabel(last)}`} fetchpriority="high" />
      <div class="plate-title">
        <h1>Wetter in Südtirol</h1>
        <p class="plate-sub">Stand {timeLabel(last)}. Die letzten {hours.length} Stunden aus {stations.temperature} Messstationen des Landeswetterdienstes, laufend aktualisiert</p>
      </div>
      <div class="plate-legend">
        <Legend legend={legend.temperature} unit="°C" title={`Lufttemperatur, ${hourOf(last)} Uhr`} every={2} />
      </div>
    </div>
  </header>

  <main>
    <section class="intro measure">
      <p class="lede">{lede}</p>
      <dl class="facts">
        <div><dt>Flächenmittel</dt><dd>{num(last.t_mean)} °C</dd></div>
        <div><dt>Änderung zu gestern</dt><dd>{tChange == null ? "–" : `${tChange > 0 ? "+" : ""}${num(tChange)} K`}</dd></div>
        <div><dt>Nullgradgrenze</dt><dd>{last.freezing_level ? `${last.freezing_level.toLocaleString("de-DE")} m` : "–"}</dd></div>
        <div><dt>Niederschlag 24 h</dt><dd>{num(rain24)} mm</dd></div>
        <div><dt>Stärkste Böe 24 h</dt><dd>{num(gust.gust_max)} m/s</dd></div>
        <div><dt>Luftdruck, Tendenz 3 h</dt><dd>{num(last.p_mean)} hPa{pTrend != null && `, ${pTrend > 0 ? "+" : ""}${num(pTrend)}`}</dd></div>
      </dl>
    </section>

    <section class="maps-section" aria-labelledby="maps-title">
      <h2 id="maps-title">Karten</h2>
      <MapViewer atlas={now} id="karte" live url />
    </section>

    <section class="hourly" aria-labelledby="hourly-title">
      <div class="section-head measure">
        <h2 id="hourly-title">Die letzten {hours.length} Stunden</h2>
        <p>Jede Kachel ist eine volle Stunde Ortszeit, {range}. Die Seite wird zweimal pro Stunde neu gebaut.</p>
      </div>

      <div class="barogram">
        <h3>Luftdruck</h3>
        <p class="note">Mittel aller Stationen mit Druckmessung, auf Meereshöhe reduziert.</p>
        <Trace hours={hours} values={hours.map((h) => h.p_mean)} unit="hPa" label="Luftdruck" />
      </div>

      <div class="variable" id="temperatur">
        <div class="variable-head">
          <h3>Temperatur</h3>
          <Legend legend={legend.temperature} unit="°C" title="Lufttemperatur" every={2} />
        </div>
        <Trace hours={hours} values={hours.map((h) => h.t_mean)} unit="°C" label="Flächenmittel der Temperatur" />
        <HourGrid atlas={now} variable="temperature" alt="Lufttemperatur" />
      </div>

      <div class="variable" id="niederschlag">
        <div class="variable-head">
          <h3>Niederschlag</h3>
          <Legend legend={legend.precipitation} unit="mm/h" title="Niederschlag pro Stunde" open />
        </div>
        <Trace hours={hours} values={hours.map((h) => h.n_area)} kind="bars" unit="mm" label="Flächenmittel des Niederschlags" digits={1} />
        <HourGrid atlas={now} variable="precipitation" alt="Niederschlag" />
      </div>

      <div class="variable" id="wind">
        <div class="variable-head">
          <h3>Wind</h3>
          <p class="note">Stundenmittel an den Stationen; ein Bild öffnet die Stunde oben in der Karte.</p>
        </div>
        <Trace hours={hours} values={hours.map((h) => h.gust_max)} unit="m/s" label="Stärkste Böe im Land" />
        <HourGrid atlas={now} variable="wind" alt="Wind" />
      </div>
    </section>

    <section class="story" aria-labelledby="total-title">
      <article class="moment total">
        <div class="moment-text">
          <h3 id="total-title">Niederschlag in {hours.length} Stunden</h3>
          <p class="when">{timeLabel(first)} bis {hourOf(last)} Uhr am {dayLabel(last)}</p>
          {total.area_mean >= 0.5
            ? <p>
                Im Flächenmittel fielen {num(total.area_mean, 0)} Millimeter.
                Am meisten an den Stationen {total.wettest.slice(0, 3).map((w) => `${w.name} (${num(w.mm, 0)} mm)`).join(", ")}.
              </p>
            : <p>Im ganzen Zeitraum fiel kaum Niederschlag.</p>}
          <Legend legend={legend.total} unit="mm" title="Niederschlagssumme" open />
        </div>
        <div class="moment-maps">
          <img class="main" src={mapUrl(now, "precipitation", "total")} width="1690" height="1090" loading="lazy"
               alt={`Niederschlagssumme der letzten ${hours.length} Stunden`} />
        </div>
      </article>
    </section>

    <section class="events measure">
      <h2>Ereignisse</h2>
      <p>Einzelne Wetterlagen bleiben mit ihren Karten erhalten, etwa die <a href={href("/ereignisse/2026-10-kaltfront/")}>Kaltfront vom 20. bis 22. Oktober 2026</a>. <a href={href("/ereignisse/")}>Alle Ereignisse</a></p>
    </section>

    <Method generated={now.generated} />
  </main>
</body>
</html>
