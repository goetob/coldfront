---
import Page from "../components/Page.astro";
import { href } from "../lib/atlas";
import { locale, path, tr, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;

// One event.json per archived event in data/events/ at the repository root.
type Event = { slug: string; title: string; title_it?: string; start: string; hours: number; summary: string; summary_it?: string };
const events = Object.values(
  import.meta.glob<{ default: Event }>("../../../data/events/*/event.json", { eager: true }),
).map((m) => m.default).sort((a, b) => b.start.localeCompare(a.start));

const when = (e: Event) =>
  new Date(`${e.start}:00`).toLocaleDateString(locale(lang), { day: "numeric", month: "long", year: "numeric" });
---
<Page lang={lang} title={tr(lang, "Ereignisse", "Eventi")}
      description={tr(lang,
        "Archivierte Wetterlagen in Südtirol, Stunde für Stunde aus den Messstationen des Landeswetterdienstes.",
        "Situazioni meteo archiviate in Alto Adige, ora per ora dalle stazioni dell’Ufficio meteorologico provinciale.")}
      alternates={{ de: path("de", "events"), it: path("it", "events") }}>
  <section class="measure intro">
    <h1 class="page-title">{tr(lang, "Ereignisse", "Eventi")}</h1>
    <p class="lede">{tr(lang, "Wetterlagen, deren Karten und Messwerte dauerhaft erhalten bleiben.", "Situazioni meteo le cui mappe e misure restano conservate.")}</p>
    <ol class="event-list">
      {events.map((e) => (
        <li>
          <a href={href(path(lang, "event", e.slug))}>{lang === "it" ? e.title_it ?? e.title : e.title}</a>
          <span class="when">{tr(lang, `ab ${when(e)}, ${e.hours} Stunden`, `dal ${when(e)}, ${e.hours} ore`)}</span>
          <p>{lang === "it" ? e.summary_it ?? e.summary : e.summary}</p>
        </li>
      ))}
    </ol>
  </section>
</Page>
