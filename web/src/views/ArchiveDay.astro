---
import Page from "../components/Page.astro";
import Legend from "../components/Legend.astro";
import { href, num } from "../lib/atlas";
import { archive, dayTitle, dayShort, type Day, type Extreme } from "../lib/archive";
import { path, tr, type Lang } from "../lib/i18n";
import { eventTitle, eventsOn } from "../lib/detected";

interface Props { lang: Lang; d: Day; newer?: string; older?: string }
const { lang, d, newer, older } = Astro.props;
const L = archive.legend;
const n1 = (v: number | null | undefined, digits = 1) => num(v, digits, lang);
const who = (e: Extreme) => (lang === "it" ? e!.name_it ?? e!.name : e!.name);
const facts: [string, Extreme, string][] = [
  [tr(lang, "Wärmste Station", "Stazione più calda"), d.warmest, "°C"],
  [tr(lang, "Kälteste Station", "Stazione più fredda"), d.coldest, "°C"],
  [tr(lang, "Nasseste Station", "Stazione più piovosa"), d.wettest, "mm"],
  [tr(lang, "Stärkste Böe", "Raffica più forte"), d.windiest, "m/s"],
  [tr(lang, "Meiste Sonne", "Più sole"), d.sunniest, tr(lang, "Stunden", "ore")],
];
const maps: [string, string][] = [
  ["tmax", tr(lang, "Höchste Temperatur", "Temperatura massima")],
  ["tmin", tr(lang, "Tiefste Temperatur", "Temperatura minima")],
  ["nsum", tr(lang, "Niederschlag", "Precipitazioni")],
];
const title = dayTitle(d.date, lang);
---
<Page lang={lang} title={title}
      description={tr(lang,
        `Wetter in Südtirol am ${title}: höchste und tiefste Temperatur und Niederschlag aus den Messstationen.`,
        `Meteo in Alto Adige, ${title}: temperatura massima e minima e precipitazioni dalle stazioni di misura.`)}
      alternates={{ de: path("de", "day", d.date), it: path("it", "day", d.date) }}
      crumbs={[[path(lang, "archive"), tr(lang, "Archiv", "Archivio")]]}>
  <section class="measure intro">
    <h1 class="page-title">{title}</h1>
    {lang === "de" ? (
      <p class="lede">
        {d.tmin_area != null && d.tmax_area != null && <>Im Flächenmittel zwischen {n1(d.tmin_area)} und {n1(d.tmax_area)} Grad. </>}
        {d.nsum_area != null && (d.nsum_area >= 0.5 ? <>Im Mittel fielen {n1(d.nsum_area)} Millimeter Niederschlag.</> : <>Es blieb weitgehend trocken.</>)}
        {d.snow_stations > 0 && <> An {d.snow_stations} Stationen lag am Abend Schnee.</>}
      </p>
    ) : (
      <p class="lede">
        {d.tmin_area != null && d.tmax_area != null && <>In media sul territorio tra {n1(d.tmin_area)} e {n1(d.tmax_area)} gradi. </>}
        {d.nsum_area != null && (d.nsum_area >= 0.5 ? <>In media sono caduti {n1(d.nsum_area)} millimetri di precipitazioni.</> : <>È rimasto per lo più asciutto.</>)}
        {d.snow_stations > 0 && <> A {d.snow_stations} stazioni la sera c’era neve.</>}
      </p>
    )}
    {eventsOn(d.date).map((e) => (
      <p class="day-events">{tr(lang, "Teil eines Ereignisses", "Parte di un evento")}: <a href={href(`${path(lang, "events")}#${e.id}`)}>{eventTitle(e, lang)}</a></p>
    ))}
    <dl class="facts">
      {facts.filter(([, e]) => e).map(([label, e, unit]) => (
        <div><dt>{label}</dt><dd>{who(e)}, {n1(e!.value)} {unit}</dd></div>
      ))}
    </dl>
    <nav class="day-nav">
      {older && <a href={href(path(lang, "day", older))}>← {dayShort(older, lang)}</a>}
      {newer && <a href={href(path(lang, "day", newer))}>{dayShort(newer, lang)} →</a>}
    </nav>
  </section>
  <section class="day-maps">
    {maps.filter(([v]) => d.maps.includes(v)).map(([v, label]) => (
      <figure>
        <figcaption><h2>{label}</h2></figcaption>
        <img src={href(`/archive/${v}/${d.date}.webp`)} width="1690" height="1090" loading="lazy" alt={`${label}, ${title}`} />
        {v === "nsum"
          ? <Legend legend={L.nsum} unit="mm" title={tr(lang, "Niederschlag des Tages", "Precipitazioni del giorno")} open />
          : <Legend legend={L.temperature} unit="°C" title={label} every={2} />}
      </figure>
    ))}
  </section>
</Page>
