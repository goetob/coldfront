---
// The map viewer: tabs for the variables, a slider through the hours of the
// set and, on the live page, the newest station values. Without JavaScript
// it shows the newest temperature map; the hourly thumbnails stay below.
import Legend from "./Legend.astro";
import { href, mapUrl, timeLabel, num, type Atlas } from "../lib/atlas";
import { path, type Lang } from "../lib/i18n";
import { archive } from "../lib/archive";

interface Props { atlas: Atlas; id: string; live?: boolean; url?: boolean; lang?: Lang }
const { atlas, id, live = false, url = false, lang = "de" } = Astro.props;
const last = atlas.hours.at(-1)!;
const { levels, colors } = atlas.legend.wind;
const n = atlas.hours.length;
// The layer against normal needs the normals of the archive.
const anomaly = !!atlas.legend.t_anom && atlas.hours.some((h) => h.layers?.includes("t_anom"));
const period = archive.normals ? archive.normals.period.join("–") : "";
// Clouds only where fetch_clouds.py got the satellite pictures.
const clouds = !!atlas.legend.clouds && atlas.hours.some((h) => h.layers?.includes("clouds"));

const T = {
  de: {
    viewer: "Kartenbetrachter", quantity: "Messgröße", stations: "Messstationen",
    tabs: { temperature: "Temperatur", precipitation: "Niederschlag", humidity: "Feuchte", pressure: "Luftdruck", wind: "Wind", snow: "Schnee", sun: "Sonne", clouds: "Wolken" },
    subs: {
      temperature: [["temperature", "Stunde"], ["t_change", "Änderung in 24 h"], ["t_anom", "Gegenüber normal"], ["tmin", "Tiefstwert des Tages"], ["tmax", "Höchstwert des Tages"]],
      precipitation: [["precipitation", "Stunde"], ["n24", "24 Stunden"], ["n72", `${n} Stunden`]],
    },
    alt: "Lufttemperatur", back: "Eine Stunde zurück", fwd: "Eine Stunde vor", play: "Abspielen", hour: "Stunde",
    filter: "Stationen", all: "alle", summits: "Gipfel und Kämme", low: "Täler und Hänge", labels: "Messwerte beschriften",
    classes: ["still", "schwach", "mäßig", "stark", "stürmisch", "Sturm"], from: "ab",
    valley: "Tal und Hang", summit: "Gipfel und Kamm", gust: "Böe ab 17 m/s", foehn: "Föhnverdacht",
    cloudNames: ["tiefe Wolken", "mittelhohe Wolken", "hohe Wolken", "Schnee, wolkenfrei", "wolkenfrei bei Tag", "wolkenfrei bei Nacht"],
    legend: {
      temperature: ["Lufttemperatur zur vollen Stunde", "Fläche aus Höhentrend und Kriging, Punkte sind die Messstationen.", " Live: Die Fläche rechnet der Browser nach demselben Verfahren aus den neuesten Messwerten, in 100 Metern Auflösung wie die Karten."],
      t_change: ["Temperaturänderung gegenüber 24 Stunden vorher", "Differenz der Temperaturfelder; zeigt Fronten, Föhn und Inversionen. Die schwarze Linie trennt Erwärmung und Abkühlung."],
      t_anom: ["Temperatur der letzten 24 Stunden gegenüber normal", `Mittel der 24 Stunden bis zur gezeigten Stunde an jeder Station, verglichen mit ihrem normalen Tagesmittel (${period}, ±15 Tage). Die Abweichungen sind ohne Höhentrend interpoliert; die schwarze Linie trennt wärmer und kälter als normal.`],
      tmin: ["Tiefste Temperatur des Tages", "Aus den Stundenwerten jeder Station, interpoliert wie die Temperatur. Der laufende Tag zählt bis zur letzten vollen Stunde."],
      tmax: ["Höchste Temperatur des Tages", "Aus den Stundenwerten jeder Station, interpoliert wie die Temperatur. Der laufende Tag zählt bis zur letzten vollen Stunde."],
      precipitation: ["Niederschlag in der Stunde", "Unter 0,2 Millimetern pro Stunde bleibt die Karte leer.", " Live: Intensität aus dem neuesten 10-Minuten-Wert jeder Station (mal 6, also Millimeter pro Stunde), im Browser interpoliert."],
      n24: ["Niederschlag in 24 Stunden", "Gleitende Summe der letzten 24 Stunden; unter einem Millimeter bleibt die Karte leer."],
      n72: [`Niederschlag in ${n} Stunden`, "Summe über den ganzen Zeitraum, nur aus Stationen, die fast jede Stunde gemeldet haben."],
      humidity: ["Relative Luftfeuchte", "Der Taupunkt wird wie die Temperatur mit Höhentrend interpoliert und mit dem Temperaturfeld zur relativen Feuchte verrechnet. Trockene Luft in den Tälern zeigt oft Föhn.", " Live: ebenso im Browser aus den neuesten Messwerten berechnet."],
      ptend: ["Luftdruckänderung in 3 Stunden", "Auf Meereshöhe reduzierter Druck. Fallender Druck kündigt oft eine Front an; die schwarze Linie trennt Fallen und Steigen."],
      wind: ["", `Pfeile zeigen, wohin der Wind weht, gemessen an ${atlas.stations.wind} Stationen und nicht interpoliert.`, " Live: die neuesten 10-Minuten-Mittel."],
      snow: ["Schneehöhe an den Stationen", "Nur an den Stationen mit Schneemessung, nicht interpoliert: Schnee hängt zu sehr von Höhe, Hang und Wind ab. Leere Kreise: kein Schnee."],
      sun: ["Sonnenschein in der Stunde", "Minuten mit Sonnenschein an den Stationen mit Sonnenscheinmessung; im Tooltip die Globalstrahlung."],
      clouds: ["Wolken vom Satelliten", "Wolkentyp (Cloud Type) des Wettersatelliten MTG der EUMETSAT, aufgenommen in den letzten 10 Minuten der Stunde, Pixel von etwa 2 Kilometern; bei Tag mit der Struktur des sichtbaren Kanals. Schnee folgt der aus dem Bild geschätzten Schneefallgrenze; findet der Satellit keinen (nachts, oder bei frischem Schnee), bleibt der des letzten Tagbilds mit Schnee, höchstens drei Tage. Der Satellit sieht nur die oberste Schicht: Nebel unter höheren Wolken oder in engen Tälern fehlt. Punkte: Stationen mit Sonnenscheinmessung."],
    },
  },
  it: {
    viewer: "Visualizzatore di mappe", quantity: "Grandezza", stations: "Stazioni di misura",
    tabs: { temperature: "Temperatura", precipitation: "Precipitazioni", humidity: "Umidità", pressure: "Pressione", wind: "Vento", snow: "Neve", sun: "Sole", clouds: "Nuvole" },
    subs: {
      temperature: [["temperature", "Ora"], ["t_change", "Variazione in 24 h"], ["t_anom", "Rispetto alla norma"], ["tmin", "Minima del giorno"], ["tmax", "Massima del giorno"]],
      precipitation: [["precipitation", "Ora"], ["n24", "24 ore"], ["n72", `${n} ore`]],
    },
    alt: "Temperatura dell’aria", back: "Un’ora indietro", fwd: "Un’ora avanti", play: "Riproduci", hour: "Ora",
    filter: "Stazioni", all: "tutte", summits: "vette e creste", low: "valli e versanti", labels: "Mostra i valori",
    classes: ["calma", "debole", "moderato", "forte", "burrascoso", "tempesta"], from: "da",
    valley: "valle e versante", summit: "vetta e cresta", gust: "raffica da 17 m/s", foehn: "sospetto di favonio",
    cloudNames: ["nubi basse", "nubi medie", "nubi alte", "neve, senza nubi", "sereno di giorno", "sereno di notte"],
    legend: {
      temperature: ["Temperatura dell’aria allo scoccare dell’ora", "Campo da tendenza con la quota e kriging, i punti sono le stazioni di misura.", " Live: il campo è calcolato dal browser con lo stesso metodo dagli ultimi valori misurati, a 100 metri di risoluzione come le mappe."],
      t_change: ["Variazione di temperatura rispetto a 24 ore prima", "Differenza tra i campi di temperatura; mostra fronti, favonio e inversioni. La linea nera separa riscaldamento e raffreddamento."],
      t_anom: ["Temperatura delle ultime 24 ore rispetto alla norma", `Media delle 24 ore fino all’ora mostrata a ogni stazione, confrontata con la sua media giornaliera normale (${period}, ±15 giorni). Gli scarti sono interpolati senza tendenza con la quota; la linea nera separa più caldo e più freddo del normale.`],
      tmin: ["Temperatura minima del giorno", "Dai valori orari di ogni stazione, interpolati come la temperatura. Il giorno in corso conta fino all’ultima ora piena."],
      tmax: ["Temperatura massima del giorno", "Dai valori orari di ogni stazione, interpolati come la temperatura. Il giorno in corso conta fino all’ultima ora piena."],
      precipitation: ["Precipitazioni nell’ora", "Sotto 0,2 millimetri all’ora la mappa resta vuota.", " Live: intensità dall’ultimo valore a 10 minuti di ogni stazione (per 6, cioè millimetri all’ora), interpolata nel browser."],
      n24: ["Precipitazioni in 24 ore", "Somma mobile delle ultime 24 ore; sotto un millimetro la mappa resta vuota."],
      n72: [`Precipitazioni in ${n} ore`, "Somma sull’intero periodo, solo dalle stazioni che hanno trasmesso quasi ogni ora."],
      humidity: ["Umidità relativa", "Il punto di rugiada viene interpolato con la quota come la temperatura e combinato con il campo di temperatura nell’umidità relativa. Aria secca nelle valli indica spesso favonio.", " Live: calcolata allo stesso modo nel browser dagli ultimi valori misurati."],
      ptend: ["Variazione di pressione in 3 ore", "Pressione ridotta al livello del mare. Una pressione in calo annuncia spesso un fronte; la linea nera separa calo e aumento."],
      wind: ["", `Le frecce indicano dove soffia il vento, misurato a ${atlas.stations.wind} stazioni e non interpolato.`, " Live: le ultime medie a 10 minuti."],
      snow: ["Altezza della neve alle stazioni", "Solo alle stazioni con misura della neve, non interpolata: la neve dipende troppo da quota, versante e vento. Cerchi vuoti: niente neve."],
      sun: ["Soleggiamento nell’ora", "Minuti di sole alle stazioni con misura del soleggiamento; nel riquadro la radiazione globale."],
      clouds: ["Nuvole dal satellite", "Tipo di nube (Cloud Type) del satellite meteorologico MTG di EUMETSAT, ripreso negli ultimi 10 minuti dell’ora, pixel di circa 2 chilometri; di giorno con la struttura del canale visibile. La neve segue il limite della neve stimato dall’immagine; se il satellite non ne trova (di notte o con neve fresca), resta quella dell’ultima immagine diurna con neve, al massimo tre giorni. Il satellite vede solo lo strato più alto: manca la nebbia sotto nubi più alte o nelle valli strette. Punti: stazioni con misura del soleggiamento."],
    },
  },
}[lang];
const L = atlas.legend;
const range = (i: number) =>
  i === colors.length - 1 ? `${T.from} ${num(levels[i], 1, lang)}` : `${num(levels[i], 1, lang)}–${num(levels[i + 1], 1, lang)}`;
const legends: [string, keyof typeof L | "total", string, { every?: number; open?: boolean }][] = [
  ["temperature", "temperature", "°C", { every: 2 }],
  ["t_change", "t_change", "K", {}],
  ...(anomaly ? [["t_anom", "t_anom", "K", {}] as [string, string, string, {}]] : []),
  ["tmin", "temperature", "°C", { every: 2 }],
  ["tmax", "temperature", "°C", { every: 2 }],
  ["precipitation", "precipitation", "mm/h", { open: true }],
  ["n24", "n24", "mm", { open: true }],
  ["n72", "total", "mm", { open: true }],
  ["humidity", "humidity", "%", {}],
  ["ptend", "ptend", "hPa", {}],
  ["snow", "snow", "cm", { open: true }],
  ["sun", "sun", "min", {}],
];
---
<figure class="viewer" id={id} data-variable="temperature" data-lang={lang} data-src={href(`/maps/${atlas.set}/viewer.json`)}
        data-maps={href(`/maps/${atlas.set}`)} data-stations={href(path(lang, "stations"))} data-url={url ? "" : undefined}
        aria-label={T.viewer}>
  <div class="viewer-tabs" role="tablist" aria-label={T.quantity}>
    {Object.entries(T.tabs).filter(([t]) => t !== "clouds" || clouds).map(([t, label], i) => (
      <button type="button" role="tab" data-tab={t} aria-selected={i === 0 ? "true" : "false"}>{label}</button>
    ))}
  </div>
  {Object.entries(T.subs).map(([t, items]) => (
    <div class="viewer-sub" data-tab={t} hidden={t !== "temperature"}>
      {items.filter(([layer]) => layer !== "t_anom" || anomaly).map(([layer, label], i) => (
        <button type="button" data-layer={layer} aria-pressed={i === 0 ? "true" : "false"}>{label}</button>
      ))}
    </div>
  ))}
  <div class="viewer-stage">
    <img class="shown" src={mapUrl(atlas, "temperature", last.stamp)} width="1690" height="1090"
         alt={`${T.alt}, ${timeLabel(last, lang)}`} />
    <img width="1690" height="1090" alt="" />
    {live && <canvas class="viewer-live" width="1690" height="1090" aria-hidden="true"></canvas>}
    <svg class="viewer-layer" viewBox="0 0 1690 1090" role="img" aria-label={T.stations}></svg>
    <div class="viewer-tip" role="status" hidden></div>
  </div>
  <div class="viewer-controls">
    <div class="viewer-time">
      <button type="button" class="prev" aria-label={T.back}>‹</button>
      <button type="button" class="play" aria-pressed="false">{T.play}</button>
      <button type="button" class="next" aria-label={T.fwd}>›</button>
      <div class="viewer-slider">
        <input type="range" min="0" max="0" step="1" aria-label={T.hour} />
        <div class="viewer-ticks" aria-hidden="true"></div>
      </div>
      {live && <button type="button" class="live" aria-pressed="false">Live</button>}
    </div>
    <output aria-live="polite"></output>
    <div class="viewer-options">
      <fieldset>
        <legend>{T.filter}</legend>
        <label><input type="radio" name={`exposure-${id}`} value="all" checked /> {T.all}</label>
        <label><input type="radio" name={`exposure-${id}`} value="summit" /> {T.summits}</label>
        <label><input type="radio" name={`exposure-${id}`} value="low" /> {T.low}</label>
      </fieldset>
      <label class="for-points"><input type="checkbox" class="labels" /> {T.labels}</label>
    </div>
  </div>
  <figcaption class="viewer-key">
    {legends.map(([layer, key, unit, opts], i) => {
      const [title, note, liveNote] = T.legend[layer as keyof typeof T.legend];
      return (
        <div data-legend={layer} hidden={i > 0}>
          <Legend legend={L[key]} unit={unit} title={title} every={opts.every} open={opts.open} />
          <p class="note">{note}{live && liveNote}</p>
        </div>
      );
    })}
    <div data-legend="wind" hidden class="wind-key">
      <span class="classes">
        {colors.map((c, i) => <span><i style={`background:${c}`} />{T.classes[i]} {range(i)} m/s</span>)}
      </span>
      <span class="symbols">
        <span><svg viewBox="0 0 30 16" aria-hidden="true"><line x1="2" y1="8" x2="18" y2="8" /><path d="M28,8 L18,3 L18,13 Z" /></svg> {T.valley}</span>
        <span><svg viewBox="0 0 30 16" aria-hidden="true"><line x1="2" y1="8" x2="18" y2="8" /><path class="open" d="M28,8 L18,3 L18,13 Z" /></svg> {T.summit}</span>
        <span><b class="gust">19</b> {T.gust}</span>
        <span><b class="foehn">F</b> {T.foehn}</span>
      </span>
      <p class="note">{T.legend.wind[1]}{live && T.legend.wind[2]}</p>
    </div>
    {clouds && (
      <div data-legend="clouds" hidden class="wind-key cloud-key">
        <strong class="key-title">{T.legend.clouds[0]}</strong>
        <span class="classes">
          {L.clouds.colors.map((c, i) => <span><i style={`background:${c}`} />{T.cloudNames[i]}</span>)}
        </span>
        <p class="note">{T.legend.clouds[1]}</p>
      </div>
    )}
  </figcaption>
</figure>

<script>
  import { initViewers } from "../lib/viewer";
  initViewers();
</script>
